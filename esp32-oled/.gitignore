# Project-wide ignores. firmware/ has its own .gitignore for PlatformIO files.

# Secrets: device env files from the dashboard and every .env* file,
# including .env.example (none of them are ever committed). The variable
# names are documented in docs/plan/README.md §8 and validated in
# backend/src/config.js. Every firmware binary in out/ contains its device
# secret too.
devices/*.env
.env
.env.*
*.env
out/

# Node.js (backend/, frontend/)
node_modules/
dist/
coverage/
*.log

# Editor and OS noise
*.swp
*~
.DS_Store
