{
  "version": 1,
  "author": "esp32-oled",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 60,
      "left": 220,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "boot",
      "top": 220,
      "left": 230,
      "attrs": { "color": "blue", "label": "BOOT (hold at start: forget login)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "oled:GND", "esp:GND.2", "black", [] ],
    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:SDA", "esp:21", "green", [] ],
    [ "oled:SCL", "esp:22", "yellow", [] ],
    [ "boot:1.l", "esp:0", "blue", [] ],
    [ "boot:2.l", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
